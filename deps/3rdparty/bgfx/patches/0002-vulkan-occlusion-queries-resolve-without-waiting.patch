+	bool CommandQueueVK::isFinished(uint64_t _submission, uint32_t _frameInFlight) const
+	{
+		if (m_submitted <= _submission)
+		{
+			return false;
+		}
+
+		// The frame-in-flight has been submitted again since: alloc waited for its fence first.
+		if (m_submitted > _submission + s_renderVK->m_maxFrameLatency)
+		{
+			return true;
+		}
+
+		return VK_SUCCESS == vkGetFenceStatus(s_renderVK->m_device, m_commandList[_frameInFlight].m_fence);
+	}
