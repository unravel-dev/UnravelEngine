 	void OcclusionQueryVK::resolve(Frame* _render)
 	{
-		while (0 != m_control.getNumUsed() )
+		const uint32_t count = BX_COUNTOF(m_handle);
+
+		while (0 != m_numCopied)
 		{
-			OcclusionQueryHandle handle = m_handle[m_control.m_read];
+			const uint32_t idx = m_control.m_read;
+
+			if (!s_renderVK->m_cmd.isFinished(m_submission[idx], m_frameInFlight[idx]) )
+			{
+				break;
+			}
+
+			OcclusionQueryHandle handle = m_handle[idx];
 			if (isValid(handle) )
 			{
-				_render->m_occlusion[handle.idx] = m_queryResult[handle.idx];
+				_render->m_occlusion[handle.idx] = m_queryResult[m_frameInFlight[idx] * count + handle.idx];
 			}
+
 			m_control.consume(1);
+			--m_numCopied;
 		}
 	}
 
