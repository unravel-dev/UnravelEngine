OpenGL ES: point sampling for depth textures and unfilterable 32-bit float textures

OpenGL ES 3.0 leaves a depth texture sampled without a comparison incomplete unless both filters are NEAREST, and
an incomplete texture reads as zero; R32F, RG32F and RGBA32F filter only with OES_texture_float_linear. The GL
renderer already forces point sampling for formats without linear filtering (s_textureFilter), but marked every
format filterable and applied it only in the per-texture sampler state, which OpenGL ES never uses: it binds
sampler objects. On OpenGL ES the depth formats, and the 32-bit float ones without OES_texture_float_linear, are
now unfilterable, and the point sampling is applied where the texture's sampler flags are resolved, for both
paths. Comparison samplers keep their filter: they filter the comparison results, which every depth format allows.
In WebGL a deferred renderer sampling its depth buffer with the default (linear) sampler saw no geometry at all.

diff --git a/src/renderer_gl.cpp b/src/renderer_gl.cpp
--- a/src/renderer_gl.cpp
+++ b/src/renderer_gl.cpp
@@ -2533,6 +2533,22 @@ namespace bgfx { namespace gl
 				// Allow all texture filters.
 				bx::memSet(s_textureFilter, true, BX_COUNTOF(s_textureFilter) );
 
+				if constexpr (BX_ENABLED(BGFX_CONFIG_RENDERER_OPENGLES) )
+				{
+					// OpenGL ES filters a depth texture sampled without a comparison only with point sampling: any other
+					// filter leaves the texture incomplete, and it reads as zero. 32-bit float textures filter only with
+					// OES_texture_float_linear.
+					for (uint32_t ii = TextureFormat::UnknownDepth + 1; ii < TextureFormat::Count; ++ii)
+					{
+						s_textureFilter[ii] = false;
+					}
+
+					const bool floatLinearSupported = s_extension[Extension::OES_texture_float_linear].m_supported;
+					s_textureFilter[TextureFormat::R32F   ] = floatLinearSupported;
+					s_textureFilter[TextureFormat::RG32F  ] = floatLinearSupported;
+					s_textureFilter[TextureFormat::RGBA32F] = floatLinearSupported;
+				}
+
 				bool bc123Supported = 0
 					|| s_extension[Extension::EXT_texture_compression_s3tc        ].m_supported
 					|| s_extension[Extension::MOZ_WEBGL_compressed_texture_s3tc   ].m_supported
@@ -7633,11 +7649,28 @@ namespace bgfx { namespace gl
 			}
 		}
 
-		const uint32_t samplerFlags = 0 != (m_flags & BGFX_TEXTURE_SRGB_MUTABLE)
+		uint32_t samplerFlags = 0 != (m_flags & BGFX_TEXTURE_SRGB_MUTABLE)
 			? flags
 			: flags | BGFX_SAMPLER_SRGB
 			;
 
+		if (!s_textureFilter[m_textureFormat]
+		&&  0 == (samplerFlags & BGFX_SAMPLER_COMPARE_MASK) )
+		{
+			// Force point sampling when the texture format doesn't support linear sampling, also through sampler
+			// objects. A comparison sampler filters the results of its comparisons, which every depth format allows.
+			samplerFlags &= ~(0
+				| BGFX_SAMPLER_MIN_MASK
+				| BGFX_SAMPLER_MAG_MASK
+				| BGFX_SAMPLER_MIP_MASK
+				);
+			samplerFlags |= 0
+				| BGFX_SAMPLER_MIN_POINT
+				| BGFX_SAMPLER_MAG_POINT
+				| BGFX_SAMPLER_MIP_POINT
+				;
+		}
+
 		if (s_renderGL->m_samplerObjectSupport)
 		{
 			s_renderGL->setSamplerState(_stage, m_numMips, samplerFlags, _palette[index], _lodMin, _lodMax);
