+void ASTPrinter::EmitInlinedContinuing(const ast::BlockStatement* continuing) {
+    TINT_SCOPED_ASSIGNMENT(inlined_continuing_, nullptr);
+    Line() << "{";
+    {
+        ScopedIndent si(this);
+        for (auto* stmt : continuing->statements) {
+            auto* break_if = stmt->As<ast::BreakIfStatement>();
+            if (!break_if) {
+                EmitStatement(stmt);
+                continue;
+            }
+            {
+                auto out = Line();
+                out << "if (";
+                EmitExpression(out, break_if->condition);
+                out << ") {";
+            }
+            {
+                ScopedIndent break_indent(this);
+                Line() << "break;";
+            }
+            Line() << "}";
+        }
+    }
+    Line() << "}";
+}
+
