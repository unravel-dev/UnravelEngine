+namespace {
+
+/// @returns true if control never runs past the end of @p stmt
+bool EndsWithJump(const ast::Statement* stmt) {
+    return Switch(
+        stmt,  //
+        [](const ast::BreakStatement*) { return true; },
+        [](const ast::ContinueStatement*) { return true; },
+        [](const ast::ReturnStatement*) { return true; },
+        [](const ast::BlockStatement* block) {
+            return !block->Empty() && EndsWithJump(block->Last());
+        },
+        [](const ast::IfStatement* if_) {
+            return if_->else_statement && EndsWithJump(if_->body) &&
+                   EndsWithJump(if_->else_statement);
+        },
+        [](Default) { return false; });
+}
+
+/// @returns true if @p stmt holds a `continue` of its enclosing loop inside a `switch`
+bool HasContinueInSwitch(const ast::Statement* stmt, bool in_switch = false) {
+    return Switch(
+        stmt,  //
+        [&](const ast::ContinueStatement*) { return in_switch; },
+        [&](const ast::BlockStatement* block) {
+            for (auto* s : block->statements) {
+                if (HasContinueInSwitch(s, in_switch)) {
+                    return true;
+                }
+            }
+            return false;
+        },
+        [&](const ast::IfStatement* if_) {
+            return HasContinueInSwitch(if_->body, in_switch) ||
+                   (if_->else_statement && HasContinueInSwitch(if_->else_statement, in_switch));
+        },
+        [&](const ast::SwitchStatement* switch_) {
+            for (auto* c : switch_->body) {
+                if (HasContinueInSwitch(c->body, true)) {
+                    return true;
+                }
+            }
+            return false;
+        },
+        // A nested loop's `continue` statements are its own.
+        [](Default) { return false; });
+}
+
+}  // namespace
