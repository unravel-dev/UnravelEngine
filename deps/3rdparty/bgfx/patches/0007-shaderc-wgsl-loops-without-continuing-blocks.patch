+    const bool inlines_continuing =
+        options_.inline_continuing_blocks && has_continuing &&
+        !(stmt->continuing->Last()->Is<ast::BreakIfStatement>() && HasContinueInSwitch(stmt->body));
+    TINT_SCOPED_ASSIGNMENT(inlined_continuing_, inlines_continuing ? stmt->continuing : nullptr);
     {
