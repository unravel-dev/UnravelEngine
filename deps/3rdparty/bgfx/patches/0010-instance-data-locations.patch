+	/// Returns the id shaderc writes into a vertex shader's attribute list for instance data i_data<_index>. It
+	/// names no attribute: idToAttrib returns Attrib::Count for it, as for the UINT16_MAX older shaderc wrote.
+	uint16_t instanceDataToId(uint8_t _index);
+
+	/// Returns the instance data index (the N of i_dataN) that attribute id `_id` names, UINT8_MAX if none.
+	uint8_t idToInstanceData(uint16_t _id);
+
 	///
 	int32_t write(bx::WriterI* _writer, const bgfx::VertexLayout& _layout, bx::Error* _err = NULL);
 
diff --git a/src/vertexlayout.cpp b/src/vertexlayout.cpp
--- a/src/vertexlayout.cpp
+++ b/src/vertexlayout.cpp
@@ -240,6 +240,23 @@ namespace bgfx
 		return s_attribToId[_attr].id;
 	}
 
+	// Instance data ids: i_data0 to i_data15, past every attribute id.
+	static constexpr uint16_t kInstanceDataIdFirst = 0x0100;
+	static constexpr uint16_t kInstanceDataIdCount = 16;
+
+	uint16_t instanceDataToId(uint8_t _index)
+	{
+		return uint16_t(kInstanceDataIdFirst + _index);
+	}
+
+	uint8_t idToInstanceData(uint16_t _id)
+	{
+		return _id >= kInstanceDataIdFirst && _id < kInstanceDataIdFirst + kInstanceDataIdCount
+			? uint8_t(_id - kInstanceDataIdFirst)
+			: UINT8_MAX
+			;
+	}
+
 	struct AttribTypeToId
 	{
 		AttribType::Enum type;
