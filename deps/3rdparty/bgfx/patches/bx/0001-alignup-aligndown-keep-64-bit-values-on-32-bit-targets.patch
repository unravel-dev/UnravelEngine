alignUp and alignDown keep the high bits of 64-bit values on 32-bit targets

Both helpers cast the value to size_t before masking it. Where size_t is 32 bits (WebAssembly, 32-bit ARM and x86)
that drops the high half of a uint64_t. bgfx's RangeAllocator keeps a buffer handle in those bits
(handle << 32 | offset) and FirstFitAllocatorT::allocFreeBlocks aligns every block address with alignUp, so on such
targets every shared dynamic vertex and index buffer is placed in the buffer whose handle is 0: CPU updates write into
the wrong GL or WebGPU buffer, or past its end. The helpers now compute in the value's own type, made unsigned, so
the result is the same as before for every value that fits in size_t.

diff --git a/include/bx/inline/bx.inl b/include/bx/inline/bx.inl
--- a/include/bx/inline/bx.inl
+++ b/include/bx/inline/bx.inl
@@ -439,8 +439,9 @@ namespace bx
 	template<typename Ty>
 	inline BX_CONSTEXPR_FUNC Ty alignDown(Ty _a, size_t _align)
 	{
-		const size_t mask = max<size_t>(1, _align) - 1;
-		return Ty(size_t(_a) & ~mask);
+		using UnsignedTy = MakeUnsignedType<Ty>;
+		const UnsignedTy mask = UnsignedTy(max<size_t>(1, _align) - 1);
+		return Ty(UnsignedTy(_a) & ~mask);
 	}
 
 	template<typename Ty>
@@ -462,8 +463,9 @@ namespace bx
 	template<typename Ty>
 	inline BX_CONSTEXPR_FUNC Ty alignUp(Ty _a, size_t _align)
 	{
-		const size_t mask = max<size_t>(1, _align) - 1;
-		return Ty( (size_t(_a) + mask) & ~mask);
+		using UnsignedTy = MakeUnsignedType<Ty>;
+		const UnsignedTy mask = UnsignedTy(max<size_t>(1, _align) - 1);
+		return Ty( (UnsignedTy(_a) + mask) & ~mask);
 	}
 
 	template<typename Ty>
