[variants]
default

[inputs]
vec3 a_position
vec4 i_data0
vec4 i_data1
vec4 i_data2
vec4 i_data3
vec4 i_data4
vec4 i_data5
vec4 i_data6
vec4 i_data7
vec4 i_data8
vec4 i_data9
vec4 i_data10
vec4 i_data11

[outputs]
flat vec4 v_decal_local_to_world0
flat vec4 v_decal_local_to_world1
flat vec4 v_decal_local_to_world2
flat vec4 v_decal_world_to_local0
flat vec4 v_decal_world_to_local1
flat vec4 v_decal_world_to_local2
flat vec4 v_decal_fade
flat vec4 v_decal_angle
flat vec4 v_material0
flat vec4 v_material1
flat vec4 v_material2
flat vec4 v_material3

[code]
#include "../common.sh"

/*
 * A decal's box (decal_pass.cpp): the unit cube, -0.5 to 0.5, placed by the instance's local-to-world rows (i_data0..2).
 * The pixels read the world-to-local rows (i_data3..5) to find the surface's place in the box, the fade (i_data6: the
 * instance's fade, age, normalized age, lifetime), the angle fade (i_data7: the cosines where it starts and ends) and the
 * material's first four parameter registers (i_data8..11), which keep decals of one material in one draw
 * (material_graph/fs_material_graph_decal.sh).
 */
void main()
{
	mat4 local_to_world = mtxFromRows(i_data0, i_data1, i_data2, vec4(0.0, 0.0, 0.0, 1.0));
	vec3 world_position = mul(local_to_world, vec4(a_position, 1.0)).xyz;
	gl_Position = mul(u_viewProj, vec4(world_position, 1.0));
	v_decal_local_to_world0 = i_data0;
	v_decal_local_to_world1 = i_data1;
	v_decal_local_to_world2 = i_data2;
	v_decal_world_to_local0 = i_data3;
	v_decal_world_to_local1 = i_data4;
	v_decal_world_to_local2 = i_data5;
	v_decal_fade = i_data6;
	v_decal_angle = i_data7;
	v_material0 = i_data8;
	v_material1 = i_data9;
	v_material2 = i_data10;
	v_material3 = i_data11;
}
