[code]
#include "../common.sh"

/*
 * The decal overdraw view (decal_pass.cpp): every fragment a decal's box shades adds one, as the decal's own pixels
 * shade every fragment of its box before they test whether the surface lies in it. The overdraw debug pass draws
 * the count as a heat ramp (particles/fs_particle_overdraw_debug.eshader).
 */
void main()
{
	gl_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
}
