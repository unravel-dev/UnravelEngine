[variants]
default
// card_capture: for the surface cache card captures: each draw brings its own world -> clip transform
// (u_card_capture_view_proj) in place of the view's, so one pass draws every capture of a frame, each into its tile of the
// capture atlas.
card_capture                 DEFERRED_GEOM_CARD_CAPTURE
skinned                      SKINNED
instanced                    INSTANCED
// *_material: for batches whose instances carry per-instance material values (material instances that share their shared
// material's draw). fs_deferred_geom.eshader's instance_material reads them in place of the material uniforms.
instanced_material           INSTANCED INSTANCE_MATERIAL
// skinned_instanced: the bone palette comes from the palette buffer (skinning_palette.sh).
// i_data0 = (first palette row, previous first palette row, LOD parameter, unused).
skinned_instanced            SKINNED_INSTANCED
skinned_instanced_material   SKINNED_INSTANCED INSTANCE_MATERIAL
// skinned_baked_instanced: for baked animation draws (baked_animation.h): the palette rows are in the mesh's model space and
// the instance carries its world matrix. i_data0..2 = world matrix rows, i_data3 = (frame row, previous frame row, LOD
// parameter, unused); u_baked_part adds the drawn submesh's palette.
skinned_baked_instanced      SKINNED_BAKED_INSTANCED

[inputs]
vec3 a_position
vec4 a_normal
vec4 a_tangent
vec4 a_bitangent
vec2 a_texcoord0
#if SKINNED || SKINNED_INSTANCED || SKINNED_BAKED_INSTANCED
vec4 a_weight
vec4 a_indices
#endif
#if INSTANCED || SKINNED_INSTANCED || SKINNED_BAKED_INSTANCED
vec4 i_data0
#endif
#if INSTANCED || SKINNED_BAKED_INSTANCED || INSTANCE_MATERIAL
vec4 i_data1
vec4 i_data2
vec4 i_data3
#endif
#if INSTANCE_MATERIAL
vec4 i_data4
#endif
#if INSTANCED && INSTANCE_MATERIAL
vec4 i_data5
vec4 i_data6
vec4 i_data7
#endif

[outputs]
vec3 v_wpos
vec3 v_pos
vec3 v_wnormal = vec3(0.0, 0.0, 1.0)
vec3 v_wtangent = vec3(1.0, 0.0, 0.0)
vec3 v_wbitangent = vec3(0.0, 1.0, 0.0)
vec2 v_texcoord0
vec2 v_lod_params
#if INSTANCE_MATERIAL
flat vec4 v_material0 = vec4(1.0, 1.0, 1.0, 1.0)
flat vec4 v_material1
flat vec4 v_material2
flat vec4 v_material3
#endif

[code]
/*
 * The position math of each variant is the same as vs_velocity.eshader's variant of its name, except that a material
 * variant has its base's: the velocity pass draws these meshes again with an EQUAL depth test.
 */

#include "../common.sh"
#if SKINNED_INSTANCED || SKINNED_BAKED_INSTANCED
#include "../skinning_palette.sh"
#endif
#include "normal_basis.sh"

#if !(INSTANCED || SKINNED_INSTANCED || SKINNED_BAKED_INSTANCED)
uniform vec4 u_lod_params;
#endif

#if DEFERRED_GEOM_CARD_CAPTURE
uniform mat4 u_card_capture_view_proj;
#define DEFERRED_GEOM_VIEW_PROJ u_card_capture_view_proj
#else
#define DEFERRED_GEOM_VIEW_PROJ u_viewProj
#endif

void main()
{
#if SKINNED
    //u_world should already be in the right space
    mat4 model = a_weight.x * u_world[int(a_indices.x)] +
                 a_weight.y * u_world[int(a_indices.y)] +
                 a_weight.z * u_world[int(a_indices.z)] +
                 a_weight.w * u_world[int(a_indices.w)];
#elif SKINNED_INSTANCED
    mat4 model = skin_palette_matrix(i_data0.x, a_indices, a_weight);
#elif SKINNED_BAKED_INSTANCED
    mat4 model = baked_skin_matrix(i_data0, i_data1, i_data2, i_data3.x, a_indices, a_weight);
#elif INSTANCED
    // i_data0..3 are the world matrix, which instances store row by row, with the LOD parameter in its [3][3] slot.
    vec4 matrix_row3 = vec4(i_data3.xyz, 1.0);
    mat4 model = mtxFromCols(i_data0, i_data1, i_data2, matrix_row3);
#else
    mat4 model = u_world[0];
#endif
    vec4 wpos = mul(model, vec4(a_position, 1.0));
    gl_Position = mul(DEFERRED_GEOM_VIEW_PROJ, wpos);

    vec4 normal = a_normal * 2.0 - 1.0;
    vec4 tangent = a_tangent * 2.0 - 1.0;
    vec4 bitangent = a_bitangent * 2.0 - 1.0;

    mat3 basis = get_upper_3x3(model);
#if SKINNED_BAKED_INSTANCED
    // One matrix for all three vectors. Tangents by the upper 3x3, as the other programs do, took this pass from 12.8 to
    // 18.4 ms with 120 enemies on the Galaxy S21 Ultra (Mali-G78, driver r38p0), though malioc scored it as cheaper.
    mat3 normal_matrix = compute_normal_matrix(basis);
    vec3 wnormal = normalize(mul(normal_matrix, normal.xyz));
    vec3 wtangent = normalize(mul(normal_matrix, tangent.xyz));
    vec3 wbitangent = normalize(mul(normal_matrix, bitangent.xyz));
#else
    vec3 wnormal = normalize(mul(compute_normal_matrix(basis), normal.xyz));
    vec3 wtangent = normalize(mul(basis, tangent.xyz));
    vec3 wbitangent = normalize(mul(basis, bitangent.xyz));
#endif

    v_wpos = wpos.xyz;
    v_pos = gl_Position.xyz / gl_Position.w;
    v_wnormal = wnormal;
    v_wtangent = wtangent;
    v_wbitangent = wbitangent;
    v_texcoord0 = a_texcoord0;
#if SKINNED_INSTANCED
    v_lod_params = vec2(i_data0.z, 0.0);
#elif SKINNED_BAKED_INSTANCED
    v_lod_params = vec2(i_data3.z, 0.0);
#elif INSTANCED
    v_lod_params = vec2(i_data3.w, 0.0);
#else
    v_lod_params = u_lod_params.xy;
#endif

#if INSTANCED && INSTANCE_MATERIAL
    // The instance's material constants (instance_material_vertex_data, pbr_material::write_instance_constants).
    v_material0 = i_data4;
    v_material1 = i_data5;
    v_material2 = i_data6;
    v_material3 = i_data7;
#elif INSTANCE_MATERIAL
    // The instance's material constants (skinned_instance_material_vertex_data, pbr_material::write_instance_constants).
    v_material0 = i_data1;
    v_material1 = i_data2;
    v_material2 = i_data3;
    v_material3 = i_data4;
#endif
}
