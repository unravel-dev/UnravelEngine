[variants]
// instance_material: for batches whose instances carry per-instance material values (vs_deferred_geom.eshader's
// *instanced_material variants); the default surface reads none, but the inputs match the vertex shader's. The card
// captures draw the default variant: the default surface clips nothing.
default
instance_material   MATERIAL_GRAPH_INSTANCE_MATERIAL

[inputs]
vec3 v_wpos
vec3 v_pos
vec3 v_wnormal
vec3 v_wtangent
vec3 v_wbitangent
vec2 v_texcoord0
vec2 v_lod_params
#ifdef MATERIAL_GRAPH_INSTANCE_MATERIAL
flat vec4 v_material0
flat vec4 v_material1
flat vec4 v_material2
flat vec4 v_material3
#endif

[code]
/*
 * What a graph material draws while its own shader is not compiled for the renderer: the Standard material's default
 * surface (engine:/data/materials/standard.mat), written by the main every graph's G-buffer shader has. Every material is
 * a graph; this shader is the stand-in, not a material of its own.
 */
#include "../common.sh"
#include "../lighting.sh"
#include "../material_graph/material_graph.sh"

// The Standard material's defaults (standard_surface in standard_material.h): a white, slightly rough dielectric.
#define DEFAULT_SURFACE_BASE_COLOR 1.0
#define DEFAULT_SURFACE_ROUGHNESS 0.3

void evaluate_material(MaterialInputs i, inout MaterialSurface s)
{
	s.base_color = vec3_splat(DEFAULT_SURFACE_BASE_COLOR);
	s.roughness = DEFAULT_SURFACE_ROUGHNESS;
}

#include "../material_graph/fs_material_graph_gbuffer.sh"
