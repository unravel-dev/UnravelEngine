[inputs]
vec3 a_position
vec3 a_normal
vec3 a_tangent
vec3 a_bitangent
vec2 a_texcoord0
vec4 a_color0
vec2 a_texcoord1
vec4 a_weight
vec4 a_indices
vec3 a_texcoord7

[outputs]
vec4 v_failed0
vec4 v_failed1
vec4 v_failed2

[code]
#include "../common.sh"

/*
 * The vertex stream check's draw (vertex_stream_check.h). Three streams make each vertex: stream 0 holds the
 * position and the basis vectors written for this draw, stream 1 the mesh's own vertices under a layout that skips
 * those four, stream 2 the previous positions as a_texcoord7. The shader works out from the vertex's index, which
 * a_texcoord0.x holds, what every attribute must hold, writes a 1 into the v_failed component of each attribute that
 * differs, and draws the vertex at the position it read: a cell of the check's grid when that came from stream 0,
 * off the target when it came from the mesh. The index is not gl_VertexID: WebGL 2 through ANGLE on Direct3D 11
 * counts gl_VertexID from the lowest index of an indexed draw whose vertices it streams (buffers the CPU updates).
 *
 * v_failed0 = position, normal, tangent, bitangent; v_failed1 = texcoord0, color0, texcoord1, weight;
 * v_failed2 = indices, texcoord7 (failure bits 0-9 of vertex_stream_check.cpp).
 */

/// x = the grid's columns, y = its rows.
uniform vec4 u_stream_check_grid;

/// Byte @p component of basis vector @p basis of vertex @p v in the check's mesh: component 0 in 20..79, 1 in
/// 100..159, 2 in 180..239 (vertex_stream_check.cpp get_mesh_basis_byte).
float get_mesh_basis_byte(int v, int basis, int component)
{
	int value = v * (7 + 4 * basis + 2 * component) + 9 * basis;
	return float(20 + 80 * component + (value - (value / 60) * 60));
}

/// Whether @p drawn, a basis vector read as 3 x Uint8 normalized, holds the mesh's bytes of basis @p basis turned as
/// the compute half turns them (y, z, x), within the 8-bit step the packing truncates by.
bool is_turned_basis(vec3 drawn, int v, int basis)
{
	vec3 expected = vec3(get_mesh_basis_byte(v, basis, 1), get_mesh_basis_byte(v, basis, 2), get_mesh_basis_byte(v, basis, 0));
	vec3 error = abs(drawn * 255.0 - expected);
	return max(error.x, max(error.y, error.z)) <= 1.5;
}

bool is_near2(vec2 drawn, vec2 expected)
{
	vec2 error = abs(drawn - expected);
	return max(error.x, error.y) <= 0.001;
}

bool is_near3(vec3 drawn, vec3 expected)
{
	vec3 error = abs(drawn - expected);
	return max(error.x, max(error.y, error.z)) <= 0.001;
}

bool is_near4(vec4 drawn, vec4 expected)
{
	vec4 error = abs(drawn - expected);
	return max(max(error.x, error.y), max(error.z, error.w)) <= 0.001;
}

/// The value of @p value modulo @p divisor for values from 0 (no signed %: fxc refuses it).
int get_remainder(int value, int divisor)
{
	return value - (value / divisor) * divisor;
}

float get_failed(bool is_right)
{
	return is_right ? 0.0 : 1.0;
}

void main()
{
	int v = int(a_texcoord0.x + 0.5);
	float fv = float(v);
	int cell = v / 3;
	int corner = v - cell * 3;
	int columns = int(u_stream_check_grid.x);
	int row = cell / columns;
	int column = cell - row * columns;
	vec2 cell_size = vec2(2.0 / u_stream_check_grid.x, 2.0 / u_stream_check_grid.y);
	vec2 corner_offset = vec2(corner == 1 ? 1.0 : 0.0, corner == 2 ? 1.0 : 0.0);
	vec3 position = vec3(vec2(-1.0, -1.0) + (vec2(float(column), float(row)) + corner_offset) * cell_size, 0.5);

	vec4 color = vec4(float(get_remainder(v * 3, 256)),
					  float(get_remainder(v * 5 + 17, 256)),
					  float(get_remainder(v * 7 + 34, 256)),
					  float(get_remainder(v * 9 + 51, 256)));
	vec4 indices = vec4(float(get_remainder(v, 128)), float(get_remainder(v + 1, 128)), 7.0, 64.0);

	v_failed0 = vec4(get_failed(is_near3(a_position, position)),
					 get_failed(is_turned_basis(a_normal, v, 0)),
					 get_failed(is_turned_basis(a_tangent, v, 1)),
					 get_failed(is_turned_basis(a_bitangent, v, 2)));
	v_failed1 = vec4(get_failed(is_near2(a_texcoord0, vec2(fv, fv * 0.5))),
					 get_failed(is_near4(a_color0 * 255.0, color)),
					 get_failed(is_near2(a_texcoord1, vec2(-fv, fv * 0.25))),
					 get_failed(is_near4(a_weight, vec4(fv * 0.125, fv + 1.0, 2.5, -fv))));
	v_failed2 = vec4(get_failed(is_near4(a_indices, indices)),
					 get_failed(is_near3(a_texcoord7, position + vec3(0.25, 0.5, 0.75))),
					 0.0,
					 0.0);
	gl_Position = vec4(a_position, 1.0);
}
