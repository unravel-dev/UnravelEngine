[code]
/*
 * The vertex stream check's compute half (vertex_stream_check.h): writes the stream a draw reads as stream 0, as a
 * morph deform pass writes its finished vertices. Each vertex's position and basis are read from the mesh's own
 * vertex buffer, changed, and packed the way the mesh packs them: the position as 3 floats, the normal, tangent and
 * bitangent as 3 x Uint8 normalized each (4 bytes, x in the low byte), 24 bytes a vertex.
 */

#include "../bgfx_compute.sh"

/// The written stream: 6 uints a vertex.
BUFFER_RAW_WO(b_stream_check_deform, 0);
/// The mesh's vertex buffer, read as uints: its stride is u_stream_check_compute.y uints.
BUFFER_RAW_RO(b_stream_check_mesh, 1);

/// x = the vertex count, y = the mesh's stride in uints.
uniform vec4 u_stream_check_compute;
/// xyz = what the written position adds to the mesh's.
uniform vec4 u_stream_check_offset;

/// The written stream's stride in uints: the position, then the three packed basis vectors.
#define DEFORM_STRIDE_UINTS 6u
/// The first basis vector's uint in a vertex of the mesh and of the written stream.
#define FIRST_BASIS_UINT 3u

/// A basis vector packed as 3 x Uint8 normalized, decoded as the mesh shaders decode it (a_normal * 2.0 - 1.0).
vec3 unpack_basis_vector(uint word)
{
	vec3 bytes = vec3(float(word & 255u), float((word >> 8u) & 255u), float((word >> 16u) & 255u));
	return bytes / 255.0 * 2.0 - 1.0;
}

/// @p value packed as bgfx::vertexPack packs a normalized 3 x Uint8 attribute marked as int: value * 127 + 128,
/// truncated.
uint pack_basis_vector(vec3 value)
{
	vec3 bytes = clamp(value, -1.0, 1.0) * 127.0 + 128.0;
	return uint(bytes.x) | (uint(bytes.y) << 8u) | (uint(bytes.z) << 16u);
}

NUM_THREADS(64, 1, 1)
void main()
{
	uint vertex_index = gl_GlobalInvocationID.x;
	if(vertex_index < uint(u_stream_check_compute.x))
	{
		uint mesh = vertex_index * uint(u_stream_check_compute.y);
		uint deform = vertex_index * DEFORM_STRIDE_UINTS;
		vec3 position = vec3(rawLoadFloat(b_stream_check_mesh, mesh),
							 rawLoadFloat(b_stream_check_mesh, mesh + 1u),
							 rawLoadFloat(b_stream_check_mesh, mesh + 2u));
		position += u_stream_check_offset.xyz;
		rawStoreFloat(b_stream_check_deform, deform, position.x);
		rawStoreFloat(b_stream_check_deform, deform + 1u, position.y);
		rawStoreFloat(b_stream_check_deform, deform + 2u, position.z);
		// Each basis vector turns its components (x, y, z) -> (y, z, x): the check's mesh keeps them far apart, so a
		// draw that read the mesh's copy differs by tens of 8-bit steps.
		for(uint basis = 0u; basis < 3u; ++basis)
		{
			vec3 value = unpack_basis_vector(rawLoadUint(b_stream_check_mesh, mesh + FIRST_BASIS_UINT + basis));
			rawStoreUint(b_stream_check_deform, deform + FIRST_BASIS_UINT + basis, pack_basis_vector(value.yzx));
		}
	}
}
