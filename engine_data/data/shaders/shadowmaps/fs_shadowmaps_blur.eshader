[variants]
default
vsm   BLUR_VSM

[inputs]
vec2 v_texcoord0
vec4 v_texcoord1
vec4 v_texcoord2
vec4 v_texcoord3
vec4 v_texcoord4

[code]
/*
 * Copyright 2013-2014 Dario Manesku. All rights reserved.
 * License: https://github.com/bkaradzic/bgfx/blob/master/LICENSE
 */

#include "common_shadow.sh"
SAMPLER2D(s_shadowMap0, 4);

#if BLUR_VSM
#define SHADOW_BLUR blur9VSM
#else
#define SHADOW_BLUR blur9
#endif

// Both directions: vs_shadowmaps_hblur.eshader and vs_shadowmaps_vblur.eshader place the samples.
void main()
{
    gl_FragColor = SHADOW_BLUR(s_shadowMap0
                               , v_texcoord0
                               , v_texcoord1
                               , v_texcoord2
                               , v_texcoord3
                               , v_texcoord4
                               );
}
