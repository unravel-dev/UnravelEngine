[variants]
default
linear                                 LINEAR
cutout                                 CUTOUT
linear_cutout                          LINEAR CUTOUT
skinned                                SKINNED
linear_skinned                         LINEAR SKINNED
skinned_cutout                         SKINNED CUTOUT
linear_skinned_cutout                  LINEAR SKINNED CUTOUT
instanced                              INSTANCED
linear_instanced                       LINEAR INSTANCED
instanced_cutout                       INSTANCED CUTOUT
linear_instanced_cutout                LINEAR INSTANCED CUTOUT
// skinned_instanced: the bone palette comes from the palette buffer (skinning_palette.sh) at the instance's first row
// (i_data0.x).
skinned_instanced                      SKINNED_INSTANCED
linear_skinned_instanced               LINEAR SKINNED_INSTANCED
skinned_instanced_cutout               SKINNED_INSTANCED CUTOUT
linear_skinned_instanced_cutout        LINEAR SKINNED_INSTANCED CUTOUT
// skinned_baked_instanced: for baked animation draws (baked_animation.h): model-space palette rows from the instance's frame
// row (i_data3.x), under the instance's world matrix rows (i_data0..2).
skinned_baked_instanced                SKINNED_BAKED_INSTANCED
linear_skinned_baked_instanced         LINEAR SKINNED_BAKED_INSTANCED
skinned_baked_instanced_cutout         SKINNED_BAKED_INSTANCED CUTOUT
linear_skinned_baked_instanced_cutout  LINEAR SKINNED_BAKED_INSTANCED CUTOUT

[inputs]
vec3 a_position
#if SKINNED || SKINNED_INSTANCED || SKINNED_BAKED_INSTANCED
vec4 a_weight
vec4 a_indices
#endif
#if CUTOUT
vec2 a_texcoord0
#endif
#if INSTANCED || SKINNED_INSTANCED || SKINNED_BAKED_INSTANCED
vec4 i_data0
#endif
#if INSTANCED || SKINNED_BAKED_INSTANCED
vec4 i_data1
vec4 i_data2
vec4 i_data3
#endif

[outputs]
#if LINEAR
float v_depth
#else
vec4 v_position
#endif
#if CUTOUT
vec2 v_texcoord0
#endif

[code]
/*
 * Copyright 2013-2014 Dario Manesku. All rights reserved.
 * License: https://github.com/bkaradzic/bgfx/blob/master/LICENSE
 */

#include "../../common.sh"
#if SKINNED_INSTANCED || SKINNED_BAKED_INSTANCED
#include "../../skinning_palette.sh"
#endif

void main()
{
#if SKINNED
    //u_world should already be in the right space
    mat4 model = a_weight.x * u_world[int(a_indices.x)] +
                 a_weight.y * u_world[int(a_indices.y)] +
                 a_weight.z * u_world[int(a_indices.z)] +
                 a_weight.w * u_world[int(a_indices.w)];
#elif SKINNED_INSTANCED
    mat4 model = skin_palette_matrix(i_data0.x, a_indices, a_weight);
#elif SKINNED_BAKED_INSTANCED
    mat4 model = baked_skin_matrix(i_data0, i_data1, i_data2, i_data3.x, a_indices, a_weight);
#elif INSTANCED
    // i_data3.w contains the LOD parameter, i_data3.xyz is the 4th row translation.
    vec4 matrix_row3 = vec4(i_data3.xyz, 1.0);
    mat4 model = mtxFromCols(i_data0, i_data1, i_data2, matrix_row3);
#else
    mat4 model = u_world[0];
#endif
    vec4 wpos = mul(model, vec4(a_position, 1.0));
    gl_Position = mul(u_viewProj, wpos);
#if LINEAR
    v_depth = gl_Position.z * 0.5 + 0.5;
#else
    v_position = gl_Position;
#endif
#if CUTOUT
    v_texcoord0 = a_texcoord0;
#endif
}
