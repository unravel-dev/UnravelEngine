[variants]
default
linear             LINEAR
cutout             CUTOUT
linear_cutout      LINEAR CUTOUT
vsm                PACK_VSM
vsm_linear         PACK_VSM LINEAR
vsm_cutout         PACK_VSM CUTOUT
vsm_linear_cutout  PACK_VSM LINEAR CUTOUT

[inputs]
#if LINEAR
float v_depth
#else
vec4 v_position
#endif
#if CUTOUT
vec2 v_texcoord0
#endif

[code]
/*
 * Copyright 2013-2014 Dario Manesku. All rights reserved.
 * License: https://github.com/bkaradzic/bgfx/blob/master/LICENSE
 */

#include "../../common.sh"
#if CUTOUT
#include "../shadow_cutout.sh"
#endif

void main()
{
#if CUTOUT
    shadowCutoutClip(v_texcoord0);
#endif
#if LINEAR
    float depth = v_depth;
#else
    float depth = v_position.z / v_position.w * 0.5 + 0.5;
#endif
#if PACK_VSM
    float depthSq = depth * depth;
    gl_FragColor = vec4(depth, depthSq, 0.0, 0.0);
#else
    gl_FragColor = vec4(depth, 0.0, 0.0, 0.0);
#endif
}
