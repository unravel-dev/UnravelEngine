[code]
/*
 * Cube mip from the mip above it: each texel is the box average of its 2x2 texels in the source mip. The source mip
 * is bound as a read-only image of the same cube: a dispatch may read one mip of a texture while it writes another,
 * but not sample it. Every face in one dispatch, a face per group along z.
 */

#include "../bgfx_compute.sh"

IMAGE2D_ARRAY_RO(i_source, rgba16f, 0);
IMAGE2D_ARRAY_WO(i_target, rgba16f, 1);

// x: the target mip's size
uniform vec4 u_downsample;

NUM_THREADS(8, 8, 1)
void main()
{
	ivec3 texel = ivec3(gl_GlobalInvocationID.xyz);
	int size = int(u_downsample.x);
	if(any(greaterThanEqual(texel.xy, ivec2(size, size))) || texel.z >= 6)
	{
		return;
	}
	ivec2 corner = texel.xy * 2;
	vec4 color = imageLoad(i_source, ivec3(corner, texel.z));
	color += imageLoad(i_source, ivec3(corner + ivec2(1, 0), texel.z));
	color += imageLoad(i_source, ivec3(corner + ivec2(0, 1), texel.z));
	color += imageLoad(i_source, ivec3(corner + ivec2(1, 1), texel.z));
	imageStore(i_target, texel, color * 0.25);
}
