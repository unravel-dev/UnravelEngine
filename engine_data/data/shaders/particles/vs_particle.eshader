[variants]
default
// lit: the particle quads of lit emitters, with the light each particle receives (particle_lighting.sh).
lit        LIT
// velocity: the particle quads of the velocity pass: the color pass's corners with their motion since the last frame. The
// clip positions are interpolated and divided per pixel (fs_particle_velocity.eshader), as the scene's velocity pass does.
velocity   VELOCITY
// textures, lit_textures, velocity_textures: the same, reading the particle data from textures (particle_common.sh) on
// devices without storage buffers in vertex shaders, as WebGL.
textures            PARTICLE_DATA_TEXTURES
lit_textures        LIT PARTICLE_DATA_TEXTURES
velocity_textures   VELOCITY PARTICLE_DATA_TEXTURES

[inputs]
vec3 a_position
vec2 a_texcoord0

[outputs]
vec3 v_texcoord0
vec2 v_texcoord1
vec4 v_color0 = vec4(1.0, 0.0, 0.0, 1.0)
vec4 v_particle = vec4(0.0, 0.0, 1.0, 0.0)
#if LIT
vec3 v_light_ambient = vec3(1.0, 1.0, 1.0)
vec4 v_light_sun
vec3 v_sun_local = vec3(0.0, 0.0, 1.0)
vec2 v_quad_uv
#endif
#if VELOCITY
vec4 v_curr_clip = vec4(0.0, 0.0, 0.0, 1.0)
vec4 v_prev_clip = vec4(0.0, 0.0, 0.0, 1.0)
vec4 v_prev_static_clip = vec4(0.0, 0.0, 0.0, 1.0)
#endif

[code]
/*
 * The particle quads of the color passes (particle_vertex.sh).
 */

#include <bgfx_shader.sh>
#include <bgfx_compute.sh>

#if PARTICLE_DATA_TEXTURES
USAMPLER2D(s_particle_records, 0);
SAMPLER2D(s_particle_static, 1);
USAMPLER2D(s_particle_dynamic, 2);
SAMPLER2D(s_particle_luts, 3);
USAMPLER2D(s_particle_sorted, 4);
#else
BUFFER_RO(s_particle_records, uint, 0);
BUFFER_RO(s_particle_static, vec4, 1);
BUFFER_RO(s_particle_dynamic, uint, 2);
BUFFER_RO(s_particle_luts, vec4, 3);
BUFFER_RO(s_particle_sorted, uint, 4);
#endif

#if VELOCITY
#include "../shaderlib.sh"
#endif
#include "particle_common.sh"
#include "particle_vertex.sh"
#if LIT
#include "particle_lighting.sh"
#endif

#if VELOCITY
// Previous frame's view-projection, jitter removed (as the velocity pass binds it).
uniform mat4 u_prev_view_proj;
#endif

void main()
{
    particle_vertex vertex = particle_build_vertex(a_position, a_texcoord0, uint(gl_InstanceID));
    gl_Position = vertex.clip;
#if VELOCITY
    // z: the opacity from which a texel writes its motion.
    v_texcoord0 = vec3(vertex.texcoord0, particle_static(vertex.emitter, PARTICLE_STATIC_STRETCH).w);
#else
    // z: the emitter's TAA response, the scale of its reactive coverage.
    v_texcoord0 = vec3(vertex.texcoord0, particle_static(vertex.emitter, PARTICLE_STATIC_STRETCH).z);
#endif
    v_texcoord1 = vertex.texcoord1;
    v_particle = vertex.particle;
    v_color0 = vertex.color;
#if LIT
    particle_light_vertex(vertex, v_light_ambient, v_light_sun, v_sun_local);
    // The unit quad's corner, -1..1: the sphere the quad stands for.
    v_quad_uv = vertex.quad_corner * 2.0;
#endif
#if VELOCITY
    // Last frame's corner: the particle's analytic motion over the emitter's frame time, plus a local-space
    // emitter's own move. The quad keeps its current shape and facing.
    float frame_time = particle_dynamic_float(vertex.emitter, PARTICLE_DYNAMIC_FRAME_TIME);
    vec3 origin_motion = vec3(particle_dynamic_float(vertex.emitter, PARTICLE_DYNAMIC_ORIGIN_MOTION),
                              particle_dynamic_float(vertex.emitter, PARTICLE_DYNAMIC_ORIGIN_MOTION + 1u),
                              particle_dynamic_float(vertex.emitter, PARTICLE_DYNAMIC_ORIGIN_MOTION + 2u));
    vec3 previous_world = vertex.world_position - vertex.velocity * frame_time - origin_motion;
    v_curr_clip = vertex.clip;
    v_prev_clip = mul(u_prev_view_proj, vec4(previous_world, 1.0));
    // The current corner through last frame's camera: the camera-only part of the motion.
    v_prev_static_clip = mul(u_prev_view_proj, vec4(vertex.world_position, 1.0));
#endif
}
