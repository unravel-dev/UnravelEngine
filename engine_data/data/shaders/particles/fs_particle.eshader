[variants]
default
// lit: for lit emitters (vs_particle.eshader's lit): the particle's color is its albedo, lit per particle and, for surface
// lighting, by the sun per pixel.
lit        LIT
// mask: mask textures (particle_fragment.sh, particle_shade_mask).
mask       MASK
mask_lit   MASK LIT

[inputs]
vec4 v_color0
vec3 v_texcoord0
vec2 v_texcoord1
vec4 v_particle
#if LIT
vec3 v_light_ambient
vec4 v_light_sun
vec3 v_sun_local
vec2 v_quad_uv
#endif

[code]
#include <bgfx_shader.sh>
#if !LIT
// Unlit particles read the volumetric fog's froxel column (particle_fragment.sh).
#define FOG_VOLUME_SAMPLER s_particle_fog_volume
#endif
#include "particle_fragment.sh"

#if MASK
#define PARTICLE_SHADE particle_shade_mask
#else
#define PARTICLE_SHADE particle_shade_multi_channel
#endif

void main()
{
#if LIT
    vec3 light = particle_pixel_light(v_light_ambient, v_light_sun, v_sun_local, v_quad_uv, v_texcoord0.xy, v_texcoord1.xy, v_particle.x);
#else
    vec3 light = vec3_splat(1.0);
#endif
    vec4 color;
    vec4 reactive;
    PARTICLE_SHADE(v_color0, v_texcoord0, v_texcoord1, v_particle, gl_FragCoord, light, color, reactive);
    gl_FragData[0] = color;
    gl_FragData[1] = reactive;
}
