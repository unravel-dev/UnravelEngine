/*
* Default styles for all the basic elements.
*/

/* Base font settings */
html, body {
	font-family: 'Inter Variable';
	/*font-family: 'Open Sans';*/
	/* font-family: 'Roboto Mono'; */

	font-size: 22dp;
	color: #f0f0f0;
	margin: 0;
}


body, div,
h1, h2, h3, h4,
h5, h6, p,
hr, pre,
ul, ol,
tabset tabs
{
	display: block;
}

span {
	display: inline;
}

img {
	display: inline-block;
}

label {
	display: inline;
	cursor: pointer;
}

ul, ol {
	margin: 1em 0;
	padding-left: 2em;
}

li {
	display: block;
}

h1
{
	font-size: 2em;
	margin: .67em 0;
}

h2
{
	font-size: 1.5em;
	margin: .75em 0;
}

h3
{
	font-size: 1.17em;
	margin: .83em 0;
}

h4, p
{
	margin: 1.12em 0;
}

h5
{
	font-size: .83em;
	margin: 1.5em 0;
}

h6
{
	font-size: .75em;
	margin: 1.67em 0;
}

h1, h2, h3, h4,
h5, h6, strong
{
	font-weight: bold;
}

em
{
	font-style: italic;
}

pre
{
	white-space: pre;
}

hr
{
	border-width: 1dp;
}

a
{
	color: #4a90e2;
	text-decoration: underline;
}
a:hover
{
	color: #357abd;
}
a:active
{
	color: #2e6bb8;
}
a:visited
{
	color: #551a8b;
}

table
{
	box-sizing: border-box;
	display: table;
}
tr
{
	box-sizing: border-box;
	display: table-row;
}
td
{
	box-sizing: border-box;
	display: table-cell;
}
col
{
	box-sizing: border-box;
	display: table-column;
}
colgroup
{
	display: table-column-group;
}
thead, tbody, tfoot
{
	display: table-row-group;
}

progress {
	box-sizing: border-box;
	display: inline-block;
	height: 1em;
	width: 10em;
	border-radius: 5dp;
	border: 2dp #555555FF;
}

progress fill {
	background-color: #4a90e2;
}



/* Forms */
input, textarea, select, option {
	font-size: 1rem;
	background-color: white;
	color: #333;
	box-sizing: border-box;
}

input.text, input.password {
	height: 2em;
	padding: 0.25em 0.5em;
	border: 1dp #c0c0c0;
	border-radius: 2dp;
	cursor: text;
	text-align: left;
}
input.text:focus-visible, input.password:focus-visible {
	border-color: #4a90e2;
}
input.text:disabled, input.password:disabled {
	opacity: 0.55;
	cursor: unavailable;
	background-color: #e9ecef;
}

input.text::placeholder, input.password::placeholder {
	color: #888;
}

textarea {
	min-height: 4em;
	padding: 0.25em 0.5em;
	border: 1dp #c0c0c0;
	border-radius: 2dp;
	cursor: text;
	text-align: left;
	line-height: 1.4;
}
textarea:focus-visible {
	border-color: #4a90e2;
}
textarea:disabled {
	opacity: 0.55;
	cursor: unavailable;
	background-color: #e9ecef;
}

textarea::placeholder {
	color: #888;
}

/* Select (dropdown) - Browser-like defaults: single border, value left, arrow right, subtle option highlight */
select {
	width: 12em;
	height: 2em;
	display: flex;
	flex-direction: row-reverse;
	border: 1dp #c0c0c0;
	border-radius: 2dp;
	background-color: white;
}

/* Value display - selected option text */
select selectvalue {
	flex: 1;
	min-width: 0;
	height: auto;
	min-height: 1.5em;
	padding: 0.2em 0.5em;
	background-color: white;
}

/* Arrow area - browser typically uses ~20dp grey block on the right */
select selectarrow {
	width: 20dp;
	flex: none;
	height: 100%;
	background-color: #f0f0f0;
	border-left: 1dp #c0c0c0;
}

select selectarrow:hover,
select:focus-visible selectarrow {
	background-color: #e8e8e8;
}

select selectarrow:active,
select selectarrow:checked {
	background-color: #e0e0e0;
}

/* Dropdown list - appears below, flush with select */
select selectbox {
	margin-left: 0;
	margin-top: 0;
	width: 100%;
	min-width: 10em;
	padding: 2dp;
	background-color: white;
	border: 1dp #c0c0c0;
	border-radius: 2dp;
}

select selectbox option {
	width: auto;
	padding: 0.25em 0.5em;
	background-color: transparent;
}

select selectbox option:hover {
	background-color: #f0f0f0;
}

select selectbox option:checked {
	background-color: #e8e8e8;
}



/* Vertical scrollbar */
scrollbarvertical {
	width: 16dp;
}
scrollbarvertical slidertrack {
	background-color: #e8e8e8;
	border: 1dp #cccccc;
	border-radius: 4dp;
}
scrollbarvertical sliderbar {
	margin-left: 2dp;
	width: 10dp;
	min-height: 25dp;
	background-color: #c0c0c0;
	border-radius: 4dp;
}
scrollbarvertical sliderbar:hover {
	background-color: #b0b0b0;
}
scrollbarvertical sliderbar:active {
	background-color: #a0a0a0;
}

/* Horizontal scrollbar */
scrollbarhorizontal {
	height: 16dp;
}
scrollbarhorizontal slidertrack {
	background-color: #e8e8e8;
	border: 1dp #cccccc;
	border-radius: 4dp;
	height: 14dp;
}
scrollbarhorizontal sliderbar {
	margin-top: 2dp;
	height: 10dp;
	min-width: 25dp;
	background-color: #c0c0c0;
	border-radius: 4dp;
}
scrollbarhorizontal sliderbar:hover {
	background-color: #b0b0b0;
}
scrollbarhorizontal sliderbar:active {
	background-color: #a0a0a0;
}

scrollbarcorner {
	background-color: #cccccc;
}

input.range {
	width: 100%;
	height: 15dp;
	transition: opacity 0.2s cubic-out;
	border-radius: 5dp;
}

input.range:disabled {
	opacity: 0.3;
}

input.range slidertrack {
	background-color: #ffffff;
	border-radius: 5dp;
}

input.range sliderbar {
	width: 25dp;
	height: 25dp;
	margin-top: -5dp;
	border-radius: 5dp;
}

input.range:hover sliderbar {
	background-color: #357abd;
}

input.range sliderbar:active {
	background-color: #2e6bb8;
}

input.range sliderbar, input.range sliderbar:disabled {
	background-color: #4a90e2;
}

input.range sliderprogress {
	background-color: #4a90e2;
	border-top-left-radius: 5dp;
	border-bottom-left-radius: 5dp;
}

input.range:hover sliderprogress {
	background-color: #357abd;
}
input.range:active sliderprogress {
	background-color: #2e6bb8;
}

input.range sliderarrowdec, input.range sliderarrowinc {
	width: 0dp;
	height: 0dp;
}
input.range sliderarrowdec {
	border-radius: 2dp 0 0 2dp;
}
input.range sliderarrowinc {
	border-radius: 0 2dp 2dp 0;
}
input.range sliderarrowdec:hover, input.range sliderarrowinc:hover {
	background-color: #dddddd;
}
input.range sliderarrowdec:active, input.range sliderarrowinc:active {
	background-color: #eeeeee;
}
input.range sliderarrowdec, input.range sliderarrowinc,
input.range sliderarrowdec:disabled, input.range sliderarrowinc:disabled {
	background-color: #cccccc;
}


input.radio, input.checkbox {
	width: 15dp;
	height: 15dp;
	border: 1dp #cccccc;
	background: #ffffff;
	border-radius: 2dp;
}
input.radio {
	border-radius: 8dp;
}
input.radio:hover, input.checkbox:hover {
	background-color: #e8e8e8;
}
input.radio:active, input.checkbox:active {
	background-color: #ddd;
}
input.radio:checked, input.checkbox:checked {
	background-color: #555;
}


button,
input.button,
input.submit,
input.reset {
	font-size: 1rem;
	font-weight: bold;
	padding: 0.5rem 1rem;
	text-align: center;
	display: inline-block;
	transition: background-color 0.2s;
}
button,
input.button,
input.submit {
	background-color: #007bff;
	color: white;
}
button:hover,
input.button:hover,
input.submit:hover {
	background-color: #0056b3;
}
button:active,
input.button:active,
input.submit:active {
	background-color: #004a99;
}
button:focus-visible,
input.button:focus-visible,
input.submit:focus-visible,
input.reset:focus-visible {
	box-shadow: 0 0 0 2dp #4a90e2;
}

/* Disabled state: visually distinct (greyed out, no hover) */
button:disabled,
input.button:disabled,
input.submit:disabled {
	opacity: 0.55;
	background-color: #6c757d;
	color: #e0e0e0;
	cursor: unavailable;
}
button:disabled:hover,
input.button:disabled:hover,
input.submit:disabled:hover {
	background-color: #6c757d;
}

/* Reset button - neutral grey, distinct from submit */
input.reset {
	background-color: #6c757d;
	color: white;
}
input.reset:hover {
	background-color: #5a6268;
}
input.reset:active {
	background-color: #545b62;
}
input.reset:disabled {
	opacity: 0.55;
	background-color: #6c757d;
	color: #e0e0e0;
	cursor: unavailable;
}
input.reset:disabled:hover {
	background-color: #6c757d;
}