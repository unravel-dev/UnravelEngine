/*
* Default styles for all the basic elements.
*/

/* Base font settings */
html, body {
	font-family: Inter 28pt;
	font-size: 22dp;
	color: #f0f0f0;
}


body, div,
h1, h2, h3, h4,
h5, h6, p,
hr, pre,
tabset tabs
{
	display: block;
}

h1
{
	font-size: 2em;
	margin: .67em 0;
}

h2
{
	font-size: 1.5em;
	margin: .75em 0;
}

h3
{
	font-size: 1.17em;
	margin: .83em 0;
}

h4, p
{
	margin: 1.12em 0;
}

h5
{
	font-size: .83em;
	margin: 1.5em 0;
}

h6
{
	font-size: .75em;
	margin: 1.67em 0;
}

h1, h2, h3, h4,
h5, h6, strong
{
	font-weight: bold;
}

em
{
	font-style: italic;
}

pre
{
	white-space: pre;
}

hr
{
	border-width: 1px;
}

table
{
	box-sizing: border-box;
	display: table;
}
tr
{
	box-sizing: border-box;
	display: table-row;
}
td
{
	box-sizing: border-box;
	display: table-cell;
}
col
{
	box-sizing: border-box;
	display: table-column;
}
colgroup
{
	display: table-column-group;
}
thead, tbody, tfoot
{
	display: table-row-group;
}

progress
{
	box-sizing: border-box;
    display: inline-block;
    height: 1em;
    width: 10em;
    vertical-align: -0.2em;
}


/* Forms */
input, textarea, select, option {
	font-size: 1rem;
	background-color: white;
	color: #333;
	box-sizing: border-box;
}



scrollbarvertical {
	z-index: 100;
	margin-top: 75dp;
	margin-bottom: 20dp;
	margin-right: 0dp;
	width: 0dp;
}
scrollbarvertical sliderbar {
	margin-left: -14dp;
	width: 12dp;
	min-height: 25dp;
	background: #d3e9ea66;
	border-radius: 4dp;
}
scrollbarvertical sliderbar:hover, scrollbarvertical sliderbar:active {
	background: #d3e9eaaa;
}

input.range {
	width: 100%;
	height: 15dp;
	transition: opacity 0.2s cubic-out;
	border-radius: 5dp;
}

input.range:disabled { 
	opacity: 0.3;
}

input.range slidertrack {
	background-color: #ffffff;
  	border-radius: 5dp;
}

input.range sliderbar {
	width: 25dp;
  	height: 25dp;
 	margin-top: -5px;
	border-radius: 5dp;
}

input.range:hover sliderbar { 
 	background-color: #357abd;
}

input.range sliderbar:active { 
	background-color: #2e6bb8;
}

input.range sliderbar, input.range sliderbar:disabled {
	background-color: #4a90e2;
}

input.range sliderprogress {
  	background-color: #4a90e2;
  	border-top-left-radius: 5dp;
  	border-bottom-left-radius: 5dp;
}

input.range:hover sliderprogress {
	background-color: #357abd;
}
input.range:active sliderprogress {
	background-color: #2e6bb8;
}

input.range sliderarrowdec, input.range sliderarrowinc {
	width: 0dp;
	height: 0dp;
}
input.range sliderarrowdec { border-radius: 2dp 0 0 2dp; }
input.range sliderarrowinc { border-radius: 0 2dp 2dp 0; }
input.range sliderarrowdec:hover,    input.range sliderarrowinc:hover    { background-color: #dddddd; }
input.range sliderarrowdec:active,   input.range sliderarrowinc:active   { background-color: #eeeeee; }
input.range sliderarrowdec,          input.range sliderarrowinc,
input.range sliderarrowdec:disabled, input.range sliderarrowinc:disabled { background-color: #cccccc; }


input.radio, input.checkbox {
	width: 15dp;
	height: 15dp;
	border: 1dp #cccccc;
	background: #ffffff;
	border-radius: 2dp;
}
input.radio {
	border-radius: 8dp;
}
input.radio:hover,   input.checkbox:hover   { background-color: #ff3; }
input.radio:active,  input.checkbox:active  { background-color: #ddd; }
input.radio:checked, input.checkbox:checked { background-color: #555; }



button {
	font-size: 1rem;
	font-weight: bold;
	padding: 0.5rem 1rem;
	background-color: #007bff;
	color: white;
	text-align: center;
	display: inline-block;
	transition: background-color 0.2s;

}

button:hover {
	background-color: #0056b3;
}