html, body {
    width: 100vw;
    height: 100vh;
    margin: 0;
    box-sizing: border-box;
}

body {
    background-color: #101014;
    font-family: Inter;
}

@keyframes splash-logo-show {
    0% {
        opacity: 0;
        transform: scale(0.96);
    }
    15% {
        opacity: 1;
        transform: scale(1);
    }
    100% {
        opacity: 1;
        transform: scale(1);
    }
}

@keyframes splash-logo-fade-out {
    0% {
        opacity: 1;
        transform: scale(1);
    }
    100% {
        opacity: 0;
        transform: scale(1);
    }
}

.splash-container {
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.splash-logo {
    display: none;
    max-width: 70vw;
    max-height: 50vh;
    width: auto;
    height: auto;
    opacity: 0;
}

.splash-logo.visible {
    display: block;
}
