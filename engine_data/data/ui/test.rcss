/* RmlUi Test Stylesheet */

body {
    font-family: Inter;
    font-size: 66dp;
    color: white;
    background-color: rgba(230, 23, 23, 0);
    margin: 10dp;
    padding: 20dp;
}

.gradient { decorator: linear-gradient(110deg, #fff3, #fff 10%, #c33 250dp, #3c3, #33c, #000 90%, #0003) border-box; }

.brightness { filter: brightness(0.5); }
.contrast { filter: contrast(0.5); }
.sepia { filter: sepia(80%); }
.grayscale { filter: grayscale(0.9); }

.saturate { filter: saturate(200%); }
.hue_rotate { filter: hue-rotate(260deg); }
.invert { filter: invert(100%); }
.opacity_low { filter: opacity(0.2); }

.blur { filter: blur(10px); }
.back_blur { backdrop-filter: blur(5px);  }

.container {
    width: 400dp;
    height: 300dp;
    background-color: rgba(135, 13, 106, 0);
    border: 2px rgb(202, 34, 34);
    border-radius: 0dp;
    padding: 20dp;
    margin: 50px auto;
    text-align: center;
}

.title {
    font-size: 24dp;
    font-weight: bold;
    color: #00ff00;
    margin-bottom: 20dp;
}

.button {
    display: inline-block;
    padding: 10px 20dp;
    background-color:rgb(78, 204, 0);
    color: white;
    border: 0dp;
    border-radius: 0dp;
    cursor: pointer;
    font-size: 16dp;
    margin: 10dp;
    transition: background-color 0.2s;
}

.button:hover {
    background-color: #004499;
}

.button:active {
    background-color: #002266;
}

.info {
    margin-top: 20dp;
    font-size: 24dp;
    font-weight: bold;
    color: #cccccc;
    line-height: 1.4;
}

.info_small {
    margin-top: 20dp;
    font-size: 24dp;
    font-weight: normal;
    color: #cccccc;
    line-height: 1.4;
}
