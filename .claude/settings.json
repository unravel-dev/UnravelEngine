{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Edit(/deps/3rdparty/**)",
      "Write(/deps/3rdparty/**)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git pull *)",
      "Bash(git pull)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash)",
      "Bash(git stash push *)",
      "Bash(git stash pop *)",
      "Bash(git stash pop)",
      "Bash(git stash apply *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/link-agent-dirs.sh\" --if-missing"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run_python.sh\" check_ascii.py"
          }
        ]
      }
    ]
  }
}
