{
 "material_graph": {
  "version": 1,
  "nodes": [
   {"id": "output", "type": "surface_output", "inputs": [
    {"pin": "base_color", "value": [0.0, 0.0, 0.0]},
    {"pin": "normal", "link": "bend"},
    {"pin": "opacity_mask", "value": [0.0]},
    {"pin": "refraction", "link": "index"}
   ], "settings": [{"name": "blend_mode", "value": "translucent"}, {"name": "shading_model", "value": "unlit"}, {"name": "particle_use", "value": "on"}]},
   {"id": "uv", "type": "texcoord"},
   {"id": "particle", "type": "particle_data"},
   {"id": "center", "type": "vector2", "inputs": [{"pin": "value", "value": [0.5, 0.5]}]},
   {"id": "disc", "type": "sphere_mask", "inputs": [
    {"pin": "position", "link": "uv"}, {"pin": "center", "link": "center"}, {"pin": "radius", "value": [0.5]}, {"pin": "hardness", "value": [0.0]}
   ]},
   {"id": "own_offset", "type": "multiply", "inputs": [{"pin": "a", "link": "particle.random"}, {"pin": "b", "value": [31.0]}]},
   {"id": "own_uv", "type": "add", "inputs": [{"pin": "a", "link": "uv"}, {"pin": "b", "link": "own_offset"}]},
   {"id": "rise", "type": "panner", "inputs": [{"pin": "uv", "link": "own_uv"}, {"pin": "speed", "value": [0.0, 0.5]}]},
   {"id": "ripples", "type": "noise", "inputs": [{"pin": "uv", "link": "rise"}, {"pin": "scale", "value": [5.0]}, {"pin": "octaves", "value": [2.0]}]},
   {"id": "color", "type": "vertex_color"},
   {"id": "edge_fade", "type": "multiply", "inputs": [{"pin": "a", "link": "disc"}, {"pin": "b", "link": "color.a"}]},
   {"id": "amount", "type": "scalar_parameter", "inputs": [{"pin": "value", "value": [0.4]}],
    "settings": [{"name": "name", "value": "Haze Strength"}]},
   {"id": "strength", "type": "multiply", "inputs": [{"pin": "a", "link": "edge_fade"}, {"pin": "b", "link": "amount"}]},
   {"id": "bend", "type": "normal_from_height", "inputs": [{"pin": "height", "link": "ripples"}, {"pin": "strength", "link": "strength"}]},
   {"id": "index", "type": "lerp", "inputs": [{"pin": "a", "value": [1.0]}, {"pin": "b", "value": [1.08]}, {"pin": "alpha", "link": "edge_fade"}]}
  ]
 }
}
