{
 "material_graph": {
  "version": 1,
  "nodes": [
   {"id": "output", "type": "surface_output", "inputs": [
    {"pin": "base_color", "value": [0.05, 0.05, 0.06]},
    {"pin": "metallic", "value": [0.8]},
    {"pin": "roughness", "value": [0.3]},
    {"pin": "emissive", "link": "pulsed_glow"}
   ]},
   {"id": "rim", "type": "fresnel", "inputs": [{"pin": "power", "value": [3.0]}]},
   {"id": "glow_color", "type": "color_parameter", "inputs": [{"pin": "value", "value": [0.2, 0.8, 1.0, 1.0]}],
    "settings": [{"name": "name", "value": "Glow Color"}]},
   {"id": "glow_intensity", "type": "scalar_parameter", "inputs": [{"pin": "value", "value": [4.0]}],
    "settings": [{"name": "name", "value": "Glow Intensity"}]},
   {"id": "rim_glow", "type": "multiply", "inputs": [{"pin": "a", "link": "glow_color.rgb"}, {"pin": "b", "link": "rim"}]},
   {"id": "bright_glow", "type": "multiply", "inputs": [{"pin": "a", "link": "rim_glow"}, {"pin": "b", "link": "glow_intensity"}]},
   {"id": "time", "type": "time"},
   {"id": "fast_time", "type": "multiply", "inputs": [{"pin": "a", "link": "time"}, {"pin": "b", "value": [3.0]}]},
   {"id": "wave", "type": "sine", "inputs": [{"pin": "in", "link": "fast_time"}]},
   {"id": "pulse", "type": "remap", "inputs": [
    {"pin": "in", "link": "wave"}, {"pin": "in_min", "value": [-1.0]}, {"pin": "out_min", "value": [0.5]}
   ]},
   {"id": "pulsed_glow", "type": "multiply", "inputs": [{"pin": "a", "link": "bright_glow"}, {"pin": "b", "link": "pulse"}]}
  ]
 }
}
