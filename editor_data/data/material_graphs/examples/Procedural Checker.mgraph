{
 "material_graph": {
  "version": 1,
  "nodes": [
   {"id": "output", "type": "surface_output", "inputs": [
    {"pin": "base_color", "link": "tiles"},
    {"pin": "roughness", "link": "roughness"}
   ]},
   {"id": "checker", "type": "checker", "inputs": [{"pin": "scale", "value": [8.0, 8.0]}]},
   {"id": "light_tile", "type": "color", "inputs": [{"pin": "value", "value": [0.9, 0.85, 0.75, 1.0]}]},
   {"id": "dark_tile", "type": "color", "inputs": [{"pin": "value", "value": [0.12, 0.13, 0.15, 1.0]}]},
   {"id": "tiles", "type": "lerp", "inputs": [
    {"pin": "a", "link": "light_tile.rgb"}, {"pin": "b", "link": "dark_tile.rgb"}, {"pin": "alpha", "link": "checker"}
   ]},
   {"id": "grime", "type": "noise", "inputs": [{"pin": "scale", "value": [24.0]}]},
   {"id": "roughness", "type": "remap", "inputs": [
    {"pin": "in", "link": "grime"}, {"pin": "out_min", "value": [0.35]}, {"pin": "out_max", "value": [0.8]}
   ]}
  ]
 }
}
