[inputs]
vec3 a_position

[outputs]
vec3 v_near_point
vec3 v_far_point

[code]
#include <bgfx_shader.sh>
#include "common.sh"

// per frame
//uniform vec4 u_camera_position;


// The pass's view takes offsets from the view origin (view_origin.sh): so are these points.
vec3 unproject_point (float x, float y, float z)
{
	vec4 unprojected_point = mul(u_invViewProj, vec4 (x, y, z, 1.0));
	
	return unprojected_point.xyz / unprojected_point.w;
}
void main()
{
	v_near_point = unproject_point (a_position.x, a_position.y, DEPTH_NEAR).xyz;
	v_far_point = unproject_point (a_position.x, a_position.y, DEPTH_FAR).xyz;

	gl_Position = vec4 (a_position, 1.0f);
}

