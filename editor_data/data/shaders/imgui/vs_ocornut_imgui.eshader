[inputs]
vec2 a_position
vec2 a_texcoord0
vec4 a_color0

[outputs]
vec4 v_color0 = vec4(1.0, 0.0, 0.0, 1.0)
vec2 v_texcoord0

[code]
#include <bgfx_shader.sh>

void main()
{
	vec4 pos = mul(u_viewProj, vec4(a_position.xy, 0.0, 1.0) );
	gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
	v_texcoord0 = a_texcoord0;
	v_color0    = a_color0;
}

